<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Munder Difflin is NOT App-Sandboxed: it spawns `claude` agents and other
       child processes that must read/write the user's own project folders.
       These hardened-runtime entitlements let Electron + node-pty run and let
       the spawned agents inherit this app's TCC responsibility, so the user is
       prompted for folder access ONCE (bound to this app), not per agent. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- No allow-dyld-environment-variables: nothing here sets DYLD_*, and it
       would let any local process inject a library into the app and use its
       folder and microphone grants (owner, 2026-10-22). -->
  <!-- Required because the app's own binary is the team's Node runtime
       (ELECTRON_RUN_AS_NODE, the hive-node and runtime/node shims): agents and
       their MCP servers load native addons from npm, signed by other teams or
       not at all, which library validation would refuse. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Persist user-granted file access (the "Documents folder" grant). -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- The mic is captured via getUserMedia by two opt-in voice features: Free
       Flow dictation and Realtime Michael (live voice chat). Under the hardened
       runtime this resource-access entitlement is required for mic capture; it
       is inert unless the user turns one of those features on. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Child processes inherit the parent's sandbox/TCC context (no-op outside
       the sandbox, harmless to include for inherited child entitlements). -->
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
